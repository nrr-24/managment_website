rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Role lookup for current user
    function isManager() {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return signedIn() && (role == "manager" || role == "admin");
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // USERS
    match /users/{userId} {
      // Allow signed-in to read user docs (so role checks never break).
      // If you want privacy later, we can tighten this and still keep role check working.
      allow get: if signedIn();
      allow list: if isManager();

      // Allow self-signup doc creation BUT only as viewer (prevents self-promotion).
      allow create: if (isSelf(userId)
                        && request.resource.data.role == "viewer"
                        && request.resource.data.email == request.auth.token.email
                        && request.resource.data.id == userId)
                    // Allow managers to create any user doc (supports createUserAsManager)
                    || (isManager()
                        && request.resource.data.id == userId);

      // Managers can update anyone
      allow update, delete: if isManager();
    }

    // RESTAURANTS / MENU
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isManager();

      match /modifiers/{modifierId} {
        allow read: if true;
        allow write: if isManager();
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isManager();

        match /dishes/{dishId} {
          allow read: if true;
          allow write: if isManager();
        }
      }
    }
    // CUSTOMER FEEDBACK — universal (not tied to a menu restaurant)
    // Managers maintain the restaurant/branch choices and build the forms; signed-in
    // customers (the app) read them and submit responses; only managers read responses.
    match /feedbackRestaurants/{id} {
      allow read: if signedIn();
      allow write: if isManager();
    }

    match /feedbackForms/{formId} {
      allow read: if signedIn();
      allow write: if isManager();

      match /responses/{responseId} {
        allow create: if signedIn()
                      && request.resource.data.keys().hasOnly(['answers', 'restaurantId', 'restaurantName', 'branchId', 'branchName', 'submittedAt', 'submittedBy'])
                      && request.resource.data.answers is list
                      && request.resource.data.answers.size() <= 50
                      && request.resource.data.restaurantName is string
                      && request.resource.data.restaurantName.size() <= 200
                      && request.resource.data.branchName is string
                      && request.resource.data.branchName.size() <= 200
                      && request.resource.data.submittedBy == request.auth.uid;
        allow read, delete: if isManager();
        allow update: if false;
      }
    }

    // IMAGE ASSETS
    match /image_assets/{assetId} {
      allow read: if true;
      allow create, update, delete: if isManager();
    }
  }
}